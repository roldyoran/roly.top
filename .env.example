# Desarrollo local: `astro dev` lee este archivo.
# Producción: estos valores viven en `wrangler.jsonc`, que se genera en CI
# desde `wrangler.example.jsonc` + secrets de GitHub. Nunca commitees
# este archivo, ni `wrangler.jsonc`, ni `.dev.vars`.
#
# Copia este archivo como `.env` y rellena tus valores:
#   cp .env.example .env

# Base pública del sitio (canonical/OG, fallback del generador QR).
PUBLIC_SITE_URL=http://localhost:4321

# URL base para Better Auth (callbacks OAuth).
BETTER_AUTH_URL=http://localhost:4321

# Secreto de sesión. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET

# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Redirect URIs a registrar:
#   http://localhost:4321/api/auth/callback/google
#   https://roly.top/api/auth/callback/google
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Lista separada por comas con los emails administradores.
ADMIN_EMAILS=tu-email@ejemplo.com

# ══════════════════════════════════════════════════════════════════════════════
# roly.top — Variables de Entorno
# ══════════════════════════════════════════════════════════════════════════════
# Copia este archivo a .env en la raíz y configura cada sección.
# NOTA: Backend y frontend usan .env SEPARADOS por seguridad.
#       Este archivo sirve como documentación centralizada.
#
# Estructura esperada:
#   roly.top/.env              ← Este archivo (template)
#   roly.top/backend/.env      ← Copiar sección BACKEND aquí
#   roly.top/frontend/.env     ← Copiar sección FRONTEND aquí
# ══════════════════════════════════════════════════════════════════════════════


# ─── BACKEND ─────────────────────────────────────────────────────────────────
# Copia estas variables a: backend/.env

# Modo desarrollo (afecta cookie secure de Better Auth)
DEV_MODE=true

# Cloudflare D1 — obtenidos tras ejecutar: bunx wrangler d1 create shorturl-db
CLOUDFLARE_D1_DATABASES_BINDING=your_binding_name
CLOUDFLARE_D1_DATABASES_NAME=your_database_name

# API Key para operaciones admin (make-admin)
SERVICE_ADMIN_API_KEY=your_service_admin_api_key

# Credenciales para drizzle-kit (push/migrate al D1 remoto)
# Obtén en: https://dash.cloudflare.com -> Workers & Pages -> Overview -> Account ID
CLOUDFLARE_ACCOUNT_ID=your_account_id
# Mismo valor que CLOUDFLARE_DATABASE_ID
CLOUDFLARE_DATABASE_ID=your_database_id
# API Token con permisos D1: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_D1_TOKEN=your_d1_api_token

# Better Auth
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
BETTER_AUTH_URL=http://localhost:8787
GOOGLE_CLIENT_ID=your_google_id
GOOGLE_CLIENT_SECRET=your_google_secret


# ─── FRONTEND ────────────────────────────────────────────────────────────────
# Copia estas variables a: frontend/.env

# API key para header x-api-key
VITE_API_KEY=your_api_key

# URL base del frontend para construir URLs cortas
# Si no está definida, usa window.location.origin
VITE_APP_BASE_URL=http://localhost:5173


# ─── GENERAR SECRETO ─────────────────────────────────────────────────────────
# Para generar BETTER_AUTH_SECRET ejecuta:
#   openssl rand -hex 32

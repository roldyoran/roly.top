              <BreadcrumbLink href="/en/">Home</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbPage>{t("footer.privacy")}</BreadcrumbPage>
            </BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>

        <h1 class="mt-10 font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
          {t("privacy.title")}
        </h1>
        <p class="mt-3 font-mono text-sm text-muted-foreground">
          {t("privacy.lastUpdated")}

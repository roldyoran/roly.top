---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/starwind/button/Button.astro";
import Card from "@/components/starwind/card/Card.astro";
import Badge from "@/components/starwind/badge/Badge.astro";
import Separator from "@/components/starwind/separator/Separator.astro";
import LanguagePicker from "@/components/LanguagePicker.astro";
import Link from "@tabler/icons/outline/link.svg";
import LayoutDashboard from "@tabler/icons/outline/layout-dashboard.svg";
import QrCode from "@tabler/icons/outline/qrcode.svg";
---

<Layout noindex={true} title="roly.top — Sign in" description="Unlimited links, stats and more — everything centralized in your dashboard.">
  <div class="bg-ambient"></div>
  <div
    class="pointer-events-none fixed inset-0 bg-cover bg-center bg-no-repeat opacity-20"
    style="background-image: url('/imgs/hero-bokeh.jpg');"
  >
  </div>
  <div
    class="pointer-events-none fixed inset-0 bg-gradient-to-b from-transparent via-background/40 to-background"
  >
  </div>

  <div class="relative z-10 mx-auto flex min-h-dvh w-full max-w-md flex-col overflow-hidden px-5 sm:max-w-lg sm:px-7">
    <!-- Top bar: back + language -->
    <div class="flex items-center justify-between pt-4">
      <a
        href="/en"
        class="flex h-9 items-center gap-1.5 rounded-lg px-2.5 font-mono text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      >
        <span aria-hidden="true">←</span> Back
      </a>
      <LanguagePicker />
    </div>

    <div class="flex flex-1 flex-col items-center justify-center py-5 text-center">
      <!-- Logo -->
    <a href="/en" class="animate-fade-in-up mb-4 flex items-center gap-2.5">
      <img
        src="/icon.svg"
        alt="roly.top"
        class="size-9 shrink-0 rounded-xl shadow-[0_0_20px_oklch(0.7_0.2_130/0.3)]"
      />
        <span class="font-display text-xl font-extrabold tracking-tight text-foreground">
          roly<span class="text-primary">.</span>top
        </span>
      </a>

      <Badge variant="outline" size="sm" class="animate-fade-in-up mb-3 gap-1.5" style="animation-delay: 0.05s;">
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-primary"></span>
        </span>
        <span class="font-mono text-[11px] tracking-wider">Secure access</span>
      </Badge>

      <!-- Main card -->
      <Card class="animate-fade-in-up w-full shadow-lg" style="animation-delay: 0.12s;">
        <div class="px-6 pt-6 pb-5 text-center sm:px-8">
          <h1 class="font-display text-xl font-bold text-foreground sm:text-2xl">
            Welcome back
          </h1>
          <p class="mx-auto mt-1.5 max-w-xs text-center text-[13px] leading-relaxed text-muted-foreground">
            Unlimited links, stats and more — everything centralized in your dashboard.
          </p>

          <Button
            id="google-login-btn"
            variant="outline"
            size="lg"
            class="google-btn mt-5 w-full gap-3 rounded-xl py-5 font-medium transition-all hover:-translate-y-px hover:border-transparent hover:shadow-[0_0_20px_oklch(0.7_0.2_130/0.15)]"
          >
            <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
                fill="#4285F4"></path>
              <path
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                fill="#34A853"></path>
              <path
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                fill="#FBBC05"></path>
              <path
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                fill="#EA4335"></path>
            </svg>
            <span data-label>Continue with Google</span>
          </Button>
          <p id="login-error" class="mt-2 hidden text-center text-xs text-red-500">
            Could not sign in. Please try again.
          </p>

          <div class="my-4 flex items-center gap-3">
            <Separator class="flex-1" />
            <span class="font-mono text-[11px] tracking-wider text-muted-foreground">1-click start</span>
            <Separator class="flex-1" />
          </div>

          <!-- Subtle benefits: compact centered row -->
          <ul class="mt-1 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 text-center">
            <li class="flex items-center gap-1.5 text-muted-foreground">
              <Link class="size-3.5 opacity-60" />
              <span class="text-[11px]">Unlimited links</span>
            </li>
            <li class="flex items-center gap-1.5 text-muted-foreground">
              <LayoutDashboard class="size-3.5 opacity-60" />
              <span class="text-[11px]">Stats and more</span>
            </li>
            <li class="flex items-center gap-1.5 text-muted-foreground">
              <QrCode class="size-3.5 opacity-60" />
              <span class="text-[11px]">All centralized</span>
            </li>
          </ul>

          <p class="mt-4 text-center text-xs leading-relaxed text-muted-foreground">
            By continuing, you agree to our{" "}
            <a href="/en/terms" class="text-primary hover:underline">terms</a>{" "}
            and{" "}
            <a href="/en/privacy" class="text-primary hover:underline">privacy</a>.
          </p>
        </div>
      </Card>

      <p class="animate-fade-in-up mt-4 text-center font-mono text-[11px] tracking-wider text-muted-foreground" style="animation-delay: 0.2s;">
        No passwords · Google only · Free
      </p>
    </div>
  </div>
</Layout>

<script>
  import { authClient } from "@/lib/auth-client";

  const btn = document.getElementById("google-login-btn") as HTMLButtonElement | null;
  const label = btn?.querySelector("[data-label]");
  const errorMsg = document.getElementById("login-error");
  const originalLabel = label?.textContent ?? "Continue with Google";

  btn?.addEventListener("click", async () => {
    if (!btn || btn.disabled) return;
    btn.disabled = true;
    btn.setAttribute("aria-busy", "true");
    btn.classList.add("opacity-70");
    if (label) label.textContent = "Connecting…";
    errorMsg?.classList.add("hidden");
    try {
      await authClient.signIn.social({ provider: "google", callbackURL: "/en/dashboard" });
    } catch {
      btn.disabled = false;
      btn.removeAttribute("aria-busy");
      btn.classList.remove("opacity-70");
      if (label) label.textContent = originalLabel;
      errorMsg?.classList.remove("hidden");
    }
  });
</script>

<style>
  .bg-ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% -20%, oklch(0.7 0.2 130 / 0.12), transparent),
      radial-gradient(ellipse 60% 40% at 80% 60%, oklch(0.6 0.15 250 / 0.06), transparent);
    pointer-events: none;
  }

  /* Animated gradient border on Google button hover only */
  @property --gb-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .google-btn {
    position: relative;
    isolation: isolate;
  }
  .google-btn::before {
    content: "";
    position: absolute;
    inset: -1.5px;
    border-radius: 14px;
    padding: 1.5px;
    background: conic-gradient(
      from var(--gb-angle),
      oklch(0.7 0.18 130),
      oklch(0.7 0.15 250),
      oklch(0.85 0.18 150),
      oklch(0.7 0.18 130)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .google-btn:hover::before,
  .google-btn:focus-visible::before {
    opacity: 1;
    animation: gb-spin 2.5s linear infinite;
  }
  @keyframes gb-spin {
    to {
      --gb-angle: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .google-btn:hover::before,
    .google-btn:focus-visible::before {
      animation: none;
    }
  }
</style>

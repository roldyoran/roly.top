---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import UrlTabs from "../components/UrlTabs.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout>
  <div class="bg-ambient"></div>
  <div
    class="pointer-events-none fixed top-[-100px] left-1/2 z-0 h-[600px] w-[900px] -translate-x-1/2 bg-[radial-gradient(ellipse_at_50%_30%,rgba(163,230,53,0.07)_0%,rgba(56,189,248,0.04)_40%,transparent_70%)]"
  >
  </div>

  <div class="relative z-10 flex min-h-screen flex-col">
    <Header />

    <main class="relative z-10 grow">
      <Hero t={t} />
      <Stats t={t} />
      <UrlTabs t={t} />
    </main>

    <Footer />
  </div>
</Layout>

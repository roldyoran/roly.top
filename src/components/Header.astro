---
import LanguagePicker from "@/components/LanguagePicker.astro";
import Button from "@/components/starwind/button/Button.astro";
import BrandGithub from "@tabler/icons/outline/brand-github.svg";
import LayoutDashboard from "@tabler/icons/outline/layout-dashboard.svg";
import Logout from "@tabler/icons/outline/logout.svg";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Sesión del middleware (`src/middleware.ts` inyecta `locals.user` en todas
// las páginas, incluida la landing). Si hay usuario, el header muestra su
// avatar/nombre en vez del botón de login.
const user = Astro.locals.user;
const dashboardHref = lang === "en" ? "/en/dashboard/" : "/es/dashboard/";
const loginHref = lang === "en" ? "/en/login" : "/es/login";
const displayName = user?.name?.trim() || user?.email || "";
const avatarInitial = (displayName.trim()[0] ?? "?").toUpperCase();
---

<header
  id="site-header"
  class="fixed top-0 right-0 left-0 z-50 flex h-14 items-center justify-between px-5 sm:h-16 sm:px-7"
>
  <div
    id="header-bg"
    class="absolute inset-0 -z-10 border-b border-border bg-background/90 backdrop-blur-md"
    style="clip-path: inset(0 0 100% 0);"
  >
  </div>
  <a href={lang === "en" ? "/en/" : "/"} class="flex items-center gap-2.5">
    <img
      src="/icon.svg"
      alt="roly.top"
      class="size-8 shrink-0 rounded-lg shadow-[0_0_16px_oklch(0.7_0.2_130/0.3)]"
    />
    <div>
      <span
        class="font-display text-lg font-extrabold tracking-tight text-foreground"
        >roly<span class="text-primary">.</span>top</span
      >
      <span
        class="-mt-0.5 block font-mono text-[11px] leading-none tracking-wider text-muted-foreground"
        >by roldyoran</span
      >
    </div>
  </a>

  <div class="hidden items-center gap-1.5 sm:flex">
    <LanguagePicker />
    <a
      href="https://github.com/roldyoran/shorturl"
      target="_blank"
      class="flex h-9 items-center gap-1.5 rounded-lg px-3 text-[13px] font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
    >
      <BrandGithub class="size-3.5 sm:size-5" />
      <span class="font-mono text-[10px] tracking-wider">{t("nav.github")}</span
      >
    </a>
    <Button
      href={dashboardHref}
      variant="outline"
      size="sm"
      as="a"
      class="h-8 gap-2 px-3 font-mono text-[10px] tracking-wider"
    >
      <LayoutDashboard class="size-4 sm:size-5" />
      {t("nav.dashboard")}
    </Button>
    {user ? (
      <>
        {/* Usuario logueado: chip con avatar/nombre hacia el dashboard */}
        <a
          href={dashboardHref}
          class="flex h-8 max-w-44 items-center gap-2 rounded-lg border border-border bg-card px-2.5 transition-colors hover:border-primary/30 hover:bg-primary/5"
          title={displayName}
        >
          {user.image ? (
            <img
              src={user.image}
              alt={displayName}
              class="size-5 shrink-0 rounded-full object-cover"
              loading="lazy"
            />
          ) : (
            <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-primary font-mono text-[10px] font-bold text-primary-foreground">
              {avatarInitial}
            </span>
          )}
          <span class="truncate font-mono text-[10px] tracking-wider text-foreground">
            {displayName}
          </span>
        </a>
        {/* Cierra sesión vía Better-Auth y vuelve a la landing (ver script abajo) */}
        <button
          type="button"
          data-signout
          title={t("nav.signOut")}
          aria-label={t("nav.signOut")}
          class="flex size-8 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >
          <Logout class="size-4" />
        </button>
      </>
    ) : (
      <Button
        href={loginHref}
        variant="outline"
        size="sm"
        as="a"
        class="h-8 gap-2 px-3 font-mono text-[10px] tracking-wider"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
            fill="#4285F4"></path>
          <path
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            fill="#34A853"></path>
          <path
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            fill="#FBBC05"></path>
          <path
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            fill="#EA4335"></path>
        </svg>
        {t("nav.signIn")}
      </Button>
    )}
  </div>

  <button
    id="mobile-menu-toggle"
    class="relative flex size-9 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:hidden"
    aria-label="Toggle menu"
    aria-expanded="false"
  >
    <span class="hamburger-line top-[11px] left-[9px]"></span>
    <span class="hamburger-line top-[18px] left-[9px]"></span>
    <span class="hamburger-line top-[25px] left-[9px]"></span>
  </button>
</header>

<div
  id="mobile-menu"
  class="menu-overlay fixed inset-0 z-40 bg-background/95 pt-14 backdrop-blur-md sm:hidden"
>
  <nav class="menu-nav flex flex-col gap-1 p-5">
    <a
      href="https://github.com/roldyoran/shorturl"
      target="_blank"
      class="menu-item flex items-center gap-3 rounded-xl px-4 py-3.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
    >
      <BrandGithub class="size-5" />
      <span class="font-mono text-sm tracking-wide">{t("nav.github")}</span>
    </a>
    <Button
      href={dashboardHref}
      variant="outline"
      size="sm"
      as="a"
      class="menu-item flex w-full items-center justify-center gap-2 px-4 py-3.5 font-mono text-sm tracking-wide"
    >
      <LayoutDashboard class="size-5" />
      {t("nav.dashboard")}
    </Button>
    {user ? (
      <>
        {/* Sesión activa en móvil: quién eres + salir */}
        <div class="menu-item flex items-center gap-3 rounded-xl border border-border bg-card px-4 py-3.5">
          {user.image ? (
            <img
              src={user.image}
              alt={displayName}
              class="size-8 shrink-0 rounded-full object-cover"
              loading="lazy"
            />
          ) : (
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary font-mono text-xs font-bold text-primary-foreground">
              {avatarInitial}
            </span>
          )}
          <span class="min-w-0 flex-1 truncate font-mono text-sm text-foreground">
            {displayName}
          </span>
        </div>
        {/* Botón nativo (no Starwind) para asegurar que el atributo
            `data-signout` llega al DOM y el script lo encuentra */}
        <button
          type="button"
          data-signout
          class="menu-item flex w-full items-center justify-center gap-2 rounded-lg px-4 py-3.5 font-mono text-sm tracking-wide text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >
          <Logout class="size-5" />
          {t("nav.signOut")}
        </button>
      </>
    ) : (
      <Button
        href={loginHref}
        variant="outline"
        size="sm"
        as="a"
        class="menu-item flex w-full items-center justify-center gap-2 px-4 py-3.5 font-mono text-sm tracking-wide"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
            fill="#4285F4"></path>
          <path
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            fill="#34A853"></path>
          <path
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            fill="#FBBC05"></path>
          <path
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            fill="#EA4335"></path>
        </svg>
        {t("nav.signIn")}
      </Button>
    )}
    <div class="menu-item my-2 border-t border-border"></div>
    <div class="menu-item flex items-center gap-3 rounded-xl px-4 py-3.5">
      <LanguagePicker />
      <span class="font-mono text-sm text-muted-foreground">Idioma</span>
    </div>
  </nav>
</div>

<style>
  .hamburger-line {
    position: absolute;
    width: 18px;
    height: 2px;
    background-color: currentColor;
    border-radius: 2px;
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
  }

  [aria-expanded="true"] .hamburger-line.top-\[11px\] {
    transform: translateY(7px) rotate(45deg);
  }
  [aria-expanded="true"] .hamburger-line.top-\[18px\] {
    opacity: 0;
    transform: scaleX(0);
  }
  [aria-expanded="true"] .hamburger-line.top-\[25px\] {
    transform: translateY(-7px) rotate(-45deg);
  }

  .menu-overlay {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.3s;
  }

  .menu-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .menu-nav {
    transform: translateY(-12px);
    opacity: 0;
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease;
  }

  .menu-overlay.is-open .menu-nav {
    transform: translateY(0);
    opacity: 1;
  }

  .menu-item {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .menu-overlay.is-open .menu-item {
    opacity: 1;
    transform: translateY(0);
  }

  .menu-overlay.is-open .menu-item:nth-child(1) {
    transition-delay: 0.06s;
  }
  .menu-overlay.is-open .menu-item:nth-child(2) {
    transition-delay: 0.12s;
  }
  .menu-overlay.is-open .menu-item:nth-child(3) {
    transition-delay: 0.18s;
  }
  .menu-overlay.is-open .menu-item:nth-child(4) {
    transition-delay: 0.24s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-line,
    .menu-overlay,
    .menu-nav,
    .menu-item {
      transition: none;
    }
  }
</style>

<script>
  // Cierre de sesión con Better-Auth (patrón de su doc oficial: `signOut`
  // + `fetchOptions.onSuccess` para redirigir). Se engancha a todo
  // `[data-signout]` (desktop y menú móvil).
  import { authClient } from "@/lib/auth-client";

  (function () {
    const headerBg = document.getElementById("header-bg");
    if (headerBg) {
      const SCROLL_END = 80;
      const onScroll = () => {
        const progress = Math.min(window.scrollY / SCROLL_END, 1);
        const bottomClip = 100 - progress * 100;
        headerBg.style.clipPath = `inset(0 0 ${bottomClip}% 0)`;
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    }

    const menuToggle = document.getElementById("mobile-menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");

    if (menuToggle && mobileMenu) {
      let isOpen = false;

      const openMenu = () => {
        isOpen = true;
        mobileMenu.classList.add("is-open");
        menuToggle.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      };

      const closeMenu = () => {
        isOpen = false;
        mobileMenu.classList.remove("is-open");
        menuToggle.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      };

      menuToggle.addEventListener("click", () => {
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      mobileMenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });
    }

    document.querySelectorAll("[data-signout]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        await authClient.signOut({
          fetchOptions: {
            onSuccess: () => {
              window.location.href = "/";
            },
          },
        });
      });
    });
  })();
</script>

---
import { Card, CardContent } from "@/components/starwind/card";
import Plus from "@tabler/icons/outline/plus.svg";
import QrCode from "@tabler/icons/outline/qrcode.svg";
import Globe from "@tabler/icons/outline/world.svg";
import Copy from "@tabler/icons/outline/copy.svg";
import Zap from "@tabler/icons/outline/bolt.svg";
import type { TranslationKey } from "@/i18n/utils";

interface Props {
  t: (key: TranslationKey) => string;
  dashboardHref: string;
  lastShortUrl: string | null;
}

const { t, dashboardHref, lastShortUrl } = Astro.props;
---

<Card class="border-border/60">
  <CardContent class="p-5">
    {/* Patrón quick actions (DESIGN_SYSTEM §8) */}
    <div class="mb-3 flex items-center gap-2">
      <div
        class="flex size-6 items-center justify-center rounded-md bg-primary/10"
        aria-hidden="true"
      >
        <Zap class="size-3.5 text-primary" />
      </div>
      <span
        class="font-mono text-xs font-bold tracking-wider text-muted-foreground uppercase"
      >
        {t("actions.title")}
      </span>
    </div>

    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      {/* Abre el diálogo de creación (lo escucha NewLinkDialog) */}
      <button
        type="button"
        data-open-new-link
        class="flex h-auto flex-col items-center gap-2 rounded-xl border border-border/60 py-3.5 transition-colors hover:border-primary/30 hover:bg-primary/5"
      >
        <div
          class="flex size-9 items-center justify-center rounded-lg bg-primary/10"
          aria-hidden="true"
        >
          <Plus class="size-4 text-primary" />
        </div>
        <span class="font-mono text-xs font-semibold">{t("actions.new")}</span>
      </button>

      <a
        href={`${dashboardHref}#qr`}
        class="flex h-auto flex-col items-center gap-2 rounded-xl border border-border/60 py-3.5 transition-colors hover:border-primary/30 hover:bg-primary/5"
      >
        <div
          class="flex size-9 items-center justify-center rounded-lg bg-primary/10"
          aria-hidden="true"
        >
          <QrCode class="size-4 text-primary" />
        </div>
        <span class="font-mono text-xs font-semibold">{t("actions.qr")}</span>
      </a>

      <a
        href={`${dashboardHref}#publicos`}
        class="flex h-auto flex-col items-center gap-2 rounded-xl border border-border/60 py-3.5 transition-colors hover:border-primary/30 hover:bg-primary/5"
      >
        <div
          class="flex size-9 items-center justify-center rounded-lg bg-primary/10"
          aria-hidden="true"
        >
          <Globe class="size-4 text-primary" />
        </div>
        <span class="font-mono text-xs font-semibold">{t("actions.public")}</span>
      </a>

      {/* Copia el último enlace (el script de LinksPanel ya maneja [data-copy]) */}
      <button
        type="button"
        data-copy={lastShortUrl ?? ""}
        disabled={!lastShortUrl}
        class="flex h-auto flex-col items-center gap-2 rounded-xl border border-border/60 py-3.5 transition-colors hover:border-primary/30 hover:bg-primary/5 disabled:cursor-not-allowed disabled:opacity-40"
      >
        <div
          class="flex size-9 items-center justify-center rounded-lg bg-primary/10"
          aria-hidden="true"
        >
          <Copy class="size-4 text-primary" />
        </div>
        <span class="font-mono text-xs font-semibold">{t("actions.copyLast")}</span>
      </button>
    </div>
  </CardContent>
</Card>

---
import Tabs from "@/components/starwind/tabs/Tabs.astro";
import TabsList from "@/components/starwind/tabs/TabsList.astro";
import TabsTrigger from "@/components/starwind/tabs/TabsTrigger.astro";
import TabsContent from "@/components/starwind/tabs/TabsContent.astro";
import PublicUrlsList from "@/components/PublicUrlsList.svelte";
import PublicQrGenerator from "@/components/PublicQrGenerator.svelte";
import PublicQrScanner from "@/components/PublicQrScanner.svelte";
import List from "@tabler/icons/outline/list.svg";
import QrCode from "@tabler/icons/outline/qrcode.svg";
import Scan from "@tabler/icons/outline/scan.svg";
import { getLangFromUrl, type TranslationKey } from "../i18n/utils";

interface Props {
  t: (key: TranslationKey) => string;
}

const { t } = Astro.props;
// Idioma para números/fechas de la isla (ver `PublicUrlsList`).
const lang = getLangFromUrl(Astro.url);
---

<div
  class="flex items-center justify-center border-b border-border bg-background"
>
  <Tabs
    defaultValue="urls"
    class="flex w-full max-w-250 flex-col items-center justify-center py-4"
  >
    <TabsList class="flex items-center justify-center">
      <TabsTrigger value="urls">
        <List class="size-3.5" />
        {t("tabs.urls")}
      </TabsTrigger>
      <TabsTrigger value="qr">
        <QrCode class="size-3.5" />
        {t("tabs.qr")}
      </TabsTrigger>
      <TabsTrigger value="scan">
        <Scan class="size-3.5" />
        {t("tabs.scan")}
      </TabsTrigger>
    </TabsList>

    <TabsContent value="urls" class="w-full px-5 pt-6 pb-10 sm:px-7">
      {/* Datos reales del backend (misma fuente que el dashboard): la isla
          hidrata con `client:visible` y trae las URLs al entrar en viewport,
          así el primer pintado del index no espera al D1. */}
      <PublicUrlsList
        client:visible
        lang={lang}
        labels={{
          copy: t("url.copy"),
          copied: t("url.copied"),
          copyFailed: t("url.copyError"),
          clicks: t("url.clicks"),
          visit: t("url.visit"),
          qr: t("tabs.qr"),
          qrClose: t("qr.close"),
          qrSave: t("qr.save"),
          downloaded: t("qr.downloaded"),
          failed: t("qr.failed"),
          empty: t("url.empty"),
          loadError: t("url.loadError"),
          retry: t("url.retry"),
        }}
      />
    </TabsContent>

    <TabsContent value="qr" class="w-full px-5 pt-6 pb-10 sm:px-7">
      {/* Generador público multitipo (100% anónimo, sin cuenta): la isla
          hidrata con `client:visible` y la lib QR (~500KB) solo se descarga
          al entrar en viewport, igual que la lista pública. */}
      <div data-qr-panel>
        <PublicQrGenerator
          client:visible
          labels={{
          title: t("qr.gen.title"),
          desc: t("qr.gen.desc"),
          typeLabel: t("qr.gen.typeLabel"),
          typeUrl: t("qr.gen.type.url"),
          typeText: t("qr.gen.type.text"),
          typeWifi: t("qr.gen.type.wifi"),
          typeVcard: t("qr.gen.type.vcard"),
          typeEmail: t("qr.gen.type.email"),
          typeSms: t("qr.gen.type.sms"),
          typePhone: t("qr.gen.type.phone"),
          typeWhatsapp: t("qr.gen.type.whatsapp"),
          typeGeo: t("qr.gen.type.geo"),
          fieldUrl: t("qr.gen.fieldUrl"),
          fieldUrlPh: t("qr.gen.fieldUrlPh"),
          fieldText: t("qr.gen.fieldText"),
          fieldTextPh: t("qr.gen.fieldTextPh"),
          fieldSsid: t("qr.gen.fieldSsid"),
          fieldSsidPh: t("qr.gen.fieldSsidPh"),
          fieldPassword: t("qr.gen.fieldPassword"),
          fieldPasswordPh: t("qr.gen.fieldPasswordPh"),
          fieldSecurity: t("qr.gen.fieldSecurity"),
          secWpa: t("qr.gen.secWpa"),
          secWep: t("qr.gen.secWep"),
          secOpen: t("qr.gen.secOpen"),
          fieldHidden: t("qr.gen.fieldHidden"),
          fieldFirstName: t("qr.gen.fieldFirstName"),
          fieldLastName: t("qr.gen.fieldLastName"),
          fieldVcardPhone: t("qr.gen.fieldVcardPhone"),
          fieldVcardEmail: t("qr.gen.fieldVcardEmail"),
          fieldOrg: t("qr.gen.fieldOrg"),
          fieldEmailTo: t("qr.gen.fieldEmailTo"),
          fieldSubject: t("qr.gen.fieldSubject"),
          fieldBody: t("qr.gen.fieldBody"),
          fieldSmsNumber: t("qr.gen.fieldSmsNumber"),
          fieldSmsMessage: t("qr.gen.fieldSmsMessage"),
          fieldPhoneNumber: t("qr.gen.fieldPhoneNumber"),
          fieldWaNumber: t("qr.gen.fieldWaNumber"),
          fieldWaNumberPh: t("qr.gen.fieldWaNumberPh"),
          fieldWaMessage: t("qr.gen.fieldWaMessage"),
          fieldLat: t("qr.gen.fieldLat"),
          fieldLng: t("qr.gen.fieldLng"),
          logo: t("qr.gen.logo"),
          invalid: t("qr.gen.invalid"),
          loadError: t("qr.gen.loadError"),
          retry: t("qr.gen.retry"),
          current: t("qr.current"),
          png: t("qr.png"),
          svg: t("qr.svg"),
          copy: t("qr.copy"),
          copied: t("qr.copied"),
          downloaded: t("qr.downloaded"),
          failed: t("qr.failed"),
          loading: t("qr.loading"),
        }}
      />
      </div>
      {/* Red de seguridad: si la isla del generador nunca hidrata (bundle
          bloqueado por red/adblock), el tab quedaba muerto en silencio. Este
          aviso solo aparece si el panel se vuelve visible y la isla no marca
          `data-qr-ready` en 12s; si la isla llega tarde, ella misma lo oculta. */}
      <p
        hidden
        data-qr-island-fallback
        class="mx-auto mt-4 max-w-3xl rounded-xl border border-error/40 bg-error/5 px-4 py-3 text-center font-mono text-xs text-error"
      >
        {t("qr.gen.islandError")}{" "}
        <button
          type="button"
          data-qr-island-reload
          class="font-bold underline underline-offset-2"
        >
          {t("qr.gen.retry")}
        </button>
      </p>
    </TabsContent>

    <TabsContent value="scan" class="w-full px-5 pt-6 pb-10 sm:px-7">
      {/* Escáner QR público (100% anónimo, sin cuenta): misma estrategia
          que el generador — isla con `client:visible`, `jsqr` se importa
          de forma dinámica al primer escaneo. */}
      <PublicQrScanner
        client:visible
        labels={{
          title: t("qr.scan.title"),
          desc: t("qr.scan.desc"),
          paste: t("qr.scan.paste"),
          upload: t("qr.scan.upload"),
          clear: t("qr.scan.clear"),
          result: t("qr.scan.result"),
          copy: t("qr.scan.copy"),
          copied: t("qr.scan.copied"),
          openLink: t("qr.scan.openLink"),
          emptyResult: t("qr.scan.emptyResult"),
          noImageYet: t("qr.scan.noImageYet"),
          dropHint: t("qr.scan.dropHint"),
          httpsNote: t("qr.scan.httpsNote"),
          statusReady: t("qr.scan.statusReady"),
          statusReading: t("qr.scan.statusReading"),
          statusAnalyzing: t("qr.scan.statusAnalyzing"),
          statusNoImage: t("qr.scan.statusNoImage"),
          statusUnsupported: t("qr.scan.statusUnsupported"),
          statusDenied: t("qr.scan.statusDenied"),
          statusClipboardEmpty: t("qr.scan.statusClipboardEmpty"),
          statusNoQr: t("qr.scan.statusNoQr"),
          statusDone: t("qr.scan.statusDone"),
          statusError: t("qr.scan.statusError"),
          statusReadError: t("qr.scan.statusReadError"),
          statusCopyError: t("qr.scan.statusCopyError"),
        }}
      />
    </TabsContent>
  </Tabs>
</div>

<script>
  // Fallback del generador QR (ver comentario en el markup): se observa el
  // panel del tab y solo cuando entra en viewport empieza a contar 12s.
  // Así no salta en falso mientras el usuario está en el otro tab.
  (function () {
    const panel = document.querySelector<HTMLElement>("[data-qr-panel]");
    const fallback = document.querySelector<HTMLElement>(
      "[data-qr-island-fallback]",
    );
    if (!panel || !fallback) return;

    document
      .querySelector("[data-qr-island-reload]")
      ?.addEventListener("click", () => window.location.reload());

    if (!("IntersectionObserver" in window)) {
      if (!document.querySelector("[data-qr-ready]")) {
        fallback.removeAttribute("hidden");
      }
      return;
    }

    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      window.setTimeout(() => {
        if (!document.querySelector("[data-qr-ready]")) {
          fallback.removeAttribute("hidden");
        }
      }, 12000);
    });
    io.observe(panel);
  })();
</script>


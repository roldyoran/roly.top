{
  "name": "@roly.top/backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy --minify",
    "check": "bunx biome check ./src",
    "lint": "bunx biome lint --write ./src",
    "format": "bunx biome format --write ./src",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:unit": "bun test tests/unit",
    "test:app": "bun test application",
    "test:utils": "bun test utils",
    "test:coverage": "bun test --coverage",
    "test:bail": "bun test --bail",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.15",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.7.6",
    "better-auth": "^1.6.15",
    "better-auth-cloudflare": "^0.3.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@cloudflare/workers-types": "^4.20260301.1",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.3",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "wrangler": "^4.69.0"
  }
}
